 def InitStaticArray():
-    global Algorithms, Greens
-    Algorithms = ReadStaticData(FINsListFile)
-    Greens = FA_Gamma.readGreenFuncs()
+    global Algorithms, Greens
+    Algorithms = ReadStaticData(FINsListFile)
+    Greens = FA_Gamma.readGreenFuncs()
+
+def InitStaticArray(plan_file=None, validate_plan: bool = True):
+    """
+    Инициализирует статические входные данные проекта.
+
+    plan_file:
+        путь к выбранному пользователем файлу Test_Plan (может называться иначе).
+        если None — используется Configs/Test_Plan.txt (как раньше).
+
+    validate_plan:
+        если True — проверяет формат Test_Plan и при ошибке возбуждает CoreHistoryInvalid.
+    """
+    global Algorithms, Greens
+    if plan_file is not None:
+        SetCoreTestPlanFile(plan_file)
+    Algorithms = ReadStaticData(FINsListFile)
+    Greens = FA_Gamma.readGreenFuncs()
+    if validate_plan:
+        ValidateCoreTestPlanFile(GetCoreTestPlanFile(), Algorithms)
+
+
+def ExportAZSetpointsByAlgorithm(scale: float, plan_file: str = None, out_path: str = None):
+    """
+    Формирует уставки АЗ в единицах тока (по каналам), для каждого Algorithm/FAs,
+    присутствующего в Test_Plan.
+
+    Логика:
+      1) для каждого (Algorithm, FAs) находим максимальную плановую мощность Pmax (Вт)
+      2) ограничивающая мощность P_lim = Pmax * scale
+      3) уставка по току для канала ch: I_set = P_lim * effectiveness(ch) для данного алгоритма
+
+    Возвращает словарь:
+      {
+        "out_path": <путь к файлу>,
+        "rows": [ {"Algorithm":..., "FAs":..., "Pmax_W":..., "Plim_W":..., "I_A":{ch:...}}, ... ]
+      }
+    """
+    global Algorithms
+    if Algorithms is None:
+        raise CoreProcException("Algorithms не инициализированы. Сначала вызовите InitStaticArray().")
+
+    if plan_file is not None:
+        SetCoreTestPlanFile(plan_file)
+
+    fn = GetCoreTestPlanFile()
+    rdr = DataReader.TDataReader(fn)
+
+    # required fields
+    TimeField = "t"
+    PowerField = "N(W)"
+    AlgField = "Algorithm"
+    FAsField = "FAs"
+    t_i = rdr.find_field_index(TimeField)
+    p_i = rdr.find_field_index(PowerField)
+    a_i = rdr.find_field_index(AlgField)
+    f_i = rdr.find_field_index(FAsField)
+
+    # max power by algorithm
+    pmax = {}  # (alg_name, n_fas) -> max power (W)
+    for rec in rdr.raw_data:
+        alg_name = rec[a_i]
+        n_fas = int(float(rec[f_i]))
+        key = (alg_name, n_fas)
+        p = float(rec[p_i])
+        if key not in pmax or p > pmax[key]:
+            pmax[key] = p
+
+    rows = []
+    for (alg_name, n_fas), pmax_w in sorted(pmax.items()):
+        key = (alg_name, n_fas)
+        if key not in Algorithms:
+            raise CoreHistoryInvalid(f"Algorithm/FAs not found in MCUFINs: {alg_name} / {n_fas}")
+
+        alg = Algorithms[key]
+        plim = pmax_w * float(scale)
+
+        I_by_ch = {}
+        for ch in sorted(alg.detectors.keys()):
+            det = alg.detectors[ch]
+            if det.effectiveness is None:
+                raise CoreHistoryInvalid(f"No effectiveness for channel {ch} in algorithm {alg_name}/{n_fas}")
+            I_by_ch[ch] = float(det.effectiveness) * plim
+
+        rows.append({
+            "Algorithm": alg_name,
+            "FAs": n_fas,
+            "Pmax_W": pmax_w,
+            "Plim_W": plim,
+            "I_A": I_by_ch,
+        })
+
+    if out_path is None:
+        out_fn = "AZ_setpoints_by_algorithm.txt"
+        out_path = os.path.abspath(os.path.join(os.curdir, ResultsDIRName, out_fn))
+    else:
+        out_path = os.path.abspath(out_path)
+
+    os.makedirs(os.path.dirname(out_path), exist_ok=True)
+
+    # build header and write
+    all_channels = sorted({ch for r in rows for ch in r["I_A"].keys()})
+    hdr = ["Algorithm", "FAs", "Pmax_W", "Plim_W"] + [f"I_ch{ch}_A" for ch in all_channels] + [f"I_ch{ch}_nA" for ch in all_channels]
+    with open(out_path, "wt", encoding="utf8") as f:
+        f.write("\t".join(hdr) + "\n")
+        for r in rows:
+            base = [r["Algorithm"], str(r["FAs"]), f"{r['Pmax_W']:.6g}", f"{r['Plim_W']:.6g}"]
+            I_A = [r["I_A"].get(ch, 0.0) for ch in all_channels]
+            I_nA = [val * 1e9 for val in I_A]
+            line = base + [f"{val:.6g}" for val in I_A] + [f"{val:.6g}" for val in I_nA]
+            f.write("\t".join(line) + "\n")
+
+    return {"out_path": out_path, "rows": rows, "scale": float(scale), "plan_file": fn}
 
 def ProcessCell(cell, hours):
     global Algorithms, Greens
     CoreHistory = TCoreHistory(Algorithms, Greens)
